import random

WORDS = ["apple", "grape", "pearl", "brick", "sugar", "crane", "flame", "pride", "sweat", "glory"]

GREEN = '\033[92m'
YELLOW = '\033[93m'
GRAY = '\033[90m'
RESET = '\033[0m'

MAX_GUESSES = 5
ALPHABET = {chr(c): None for c in range(ord('a'), ord('z') + 1)}

def color_letter(letter, color):
    return f"{color}{letter.upper()}{RESET}"

def evaluate_guess(guess, target):
    feedback = []
    target_letters = list(target)
    guess_letters = list(guess)

    for i in range(5):
        if guess_letters[i] == target_letters[i]:
            feedback.append((guess_letters[i], GREEN))
            target_letters[i] = None
        else:
            feedback.append((guess_letters[i], None))

    for i in range(5):
        if feedback[i][1] is None:
            if guess_letters[i] in target_letters:
                feedback[i] = (guess_letters[i], YELLOW)
                target_letters[target_letters.index(guess_letters[i])] = None
            else:
                feedback[i] = (guess_letters[i], GRAY)
    return feedback

def update_alphabet(feedback):
    for letter, color in feedback:
        prev_color = ALPHABET[letter]
        if prev_color == GREEN:
            continue
        if color == GREEN or (color == YELLOW and prev_color != GREEN):
            ALPHABET[letter] = color
        elif color == GRAY and ALPHABET[letter] is None:
            ALPHABET[letter] = GRAY

def display_alphabet():
    print("\nAlphabet: ", end='')
    for c in range(ord('a'), ord('z') + 1):
        letter = chr(c)
        color = ALPHABET[letter]
        if color:
            print(color_letter(letter, color), end=' ')
        else:
            print(letter.upper(), end=' ')
    print('\n')

def play_game():
    target = random.choice(WORDS)
    attempts = 0

    while attempts < MAX_GUESSES:
        guess = input(f"Guess {attempts+1}/{MAX_GUESSES}: ").lower()
        if len(guess) != 5 or not guess.isalpha():
            print("Please enter a valid 5-letter word.")
            continue

        feedback = evaluate_guess(guess, target)
        update_alphabet(feedback)

        print("Result: ", end='')
        for letter, color in feedback:
            print(color_letter(letter, color), end='')
        print()

        display_alphabet()

        if guess == target:
            print(GREEN + "Congratulations! You guessed the word!" + RESET)
            break

        attempts += 1

    if guess != target:
        print(f"Out of guesses! The word was: {target.upper()}")

if __name__ == "__main__":
    play_game()
